# Database (Docker Compose defaults)
DATABASE_URL=postgresql+asyncpg://health:health_dev_password@localhost:5433/health_intelligence

# JWT (RS256) — paths relative to repo root or absolute
JWT_PRIVATE_KEY_PATH=../keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=../keys/jwt_public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=Patient Health Intelligence Platform
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
INACTIVITY_TIMEOUT_MINUTES=15

SECRET_KEY=change-me-in-production-use-vault
FRONTEND_URL=http://localhost:3000

# SMTP — used to send verification and password-reset emails (not logged).
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USE_TLS=true
# Use an app password, not your normal account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Spondon
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Require a verified email before uploads. Leave false locally; set true in production.
REQUIRE_EMAIL_VERIFICATION=false

# Redis / Celery (host 6380 if using docker-compose redis)
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0

# Backblaze B2 (S3-compatible). Create a *private* bucket named B2_BUCKET (or let the API
# create it on startup if the key has writeBuckets). A key without a bucket is not enough.
# Do not enable public / Share files. Browser PUTs also need CORS (s3_put); the API sets
# CORS_ORIGINS on startup if the key has writeBucketCors.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=spondon-health-docs
B2_REGION=us-west-004
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com

